{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(scaleforge_http_requests_total[5m]))", "refId": "A" }],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scaleforge_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "title": "p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "sum(rate(scaleforge_http_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }
      ],
      "title": "5xx rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "sum by (type) (rate(scaleforge_outbox_published_total[5m]))", "refId": "A" }
      ],
      "title": "Outbox publish rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [{ "expr": "{container=~\".*(api|worker).*\"}", "refId": "A" }],
      "title": "API and worker logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 40,
  "tags": ["scaleforge", "red"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "ScaleForge Overview",
  "uid": "scaleforge-overview",
  "version": 1
}
