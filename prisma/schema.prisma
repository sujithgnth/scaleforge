generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(320)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  displayName  String         @map("display_name") @db.VarChar(100)
  role         Role           @default(USER)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders       Order[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]     @relation("AuditActor")

  @@index([role, active], map: "users_role_active_idx")
  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "refresh_tokens_user_expiry_idx")
  @@map("refresh_tokens")
}

model Restaurant {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(160)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  menuItems MenuItem[]
  orders    Order[]

  @@index([active, name], map: "restaurants_active_name_idx")
  @@map("restaurants")
}

model MenuItem {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String     @db.VarChar(160)
  price        Decimal    @db.Decimal(12, 2)
  available    Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]

  @@index([restaurantId, available], map: "menu_items_restaurant_available_idx")
  @@map("menu_items")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  version      Int         @default(1)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]

  @@index([userId, createdAt(sort: Desc)], map: "orders_user_created_idx")
  @@index([restaurantId, status, createdAt(sort: Desc)], map: "orders_restaurant_status_created_idx")
  @@index([status, createdAt(sort: Desc)], map: "orders_status_created_idx")
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  name       String   @db.VarChar(160)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity   Int
  lineTotal  Decimal  @map("line_total") @db.Decimal(12, 2)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "order_items_order_idx")
  @@index([menuItemId], map: "order_items_menu_item_idx")
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(100)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("EUR") @db.Char(3)
  status         PaymentStatus @default(PENDING)
  providerRef    String?       @map("provider_ref") @db.VarChar(160)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status], map: "payments_order_status_idx")
  @@map("payments")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  aggregateType String   @map("aggregate_type") @db.VarChar(80)
  aggregateId   String   @map("aggregate_id") @db.VarChar(100)
  metadata      Json?
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([aggregateType, aggregateId, createdAt(sort: Desc)], map: "audit_aggregate_created_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "audit_actor_created_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String    @db.VarChar(100)
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(100)
  payload       Json
  correlationId String?   @map("correlation_id") @db.VarChar(100)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?   @map("locked_by") @db.VarChar(100)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, nextAttemptAt, createdAt], map: "outbox_pending_idx")
  @@index([lockedAt], map: "outbox_lock_idx")
  @@map("outbox_events")
}

model ProcessedMessage {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([consumer, eventId], map: "processed_messages_consumer_event_key")
  @@index([processedAt], map: "processed_messages_processed_idx")
  @@map("processed_messages")
}

model NotificationDelivery {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @map("event_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  channel   String         @default("IN_APP") @db.VarChar(30)
  template  String         @db.VarChar(100)
  payload   Json
  status    DeliveryStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?        @map("last_error") @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventId, channel], map: "notification_event_channel_key")
  @@index([status, createdAt], map: "notification_status_created_idx")
  @@map("notification_deliveries")
}
