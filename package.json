{
  "name": "scaleforge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Production-style modular NestJS foundation for resilience and performance experiments.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node --import ./dist/instrumentation.js dist/worker.js",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,test,prisma,scripts}/**/*.ts\" \"**/*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"{src,test,prisma,scripts}/**/*.ts\" \"**/*.{md,json,yml,yaml}\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-unit.json --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.json --runInBand",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-unit.json --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "openapi:generate": "npm run build --silent && tsx scripts/generate-openapi.ts",
    "verify": "npm run lint && npm run build && npm test && npm run test:e2e && npm run openapi:generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nestjs": "10.70.0",
    "amqplib": "0.10.9",
    "argon2": "0.44.0",
    "bullmq": "6.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.1",
    "@testcontainers/postgresql": "11.10.0",
    "@testcontainers/rabbitmq": "11.10.0",
    "@testcontainers/redis": "11.10.0",
    "@types/amqplib": "0.10.8",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "29.7.0",
    "prettier": "3.7.3",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "overrides": {
    "js-yaml": "5.3.0"
  }
}
