{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [".ts"],
  "testEnvironment": "node",
  "testRegex": "test/.*\\.integration-spec\\.ts$",
  "testTimeout": 180000,
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json", "useESM": true }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
